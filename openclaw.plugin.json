{
  "id": "opencode-cli",
  "name": "OpenCode CLI Backend",
  "description": "CLI backend routing the existing opencode provider through the local OpenCode CLI (no direct Zen inference call).",
  "providers": ["opencode"],
  "cliBackends": [
    "opencode-cli"
  ],
  "syntheticAuthRefs": ["opencode-cli"],
  "providerCatalogEntry": "./src/provider-discovery.js",
  "setup": {
    "cliBackends": [
      "opencode-cli"
    ],
    "requiresRuntime": false
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false
  }
}
